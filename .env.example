APP_NAME="CMS Blog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Host port mappings for docker-compose (dev). Container internal ports stay fixed.
HOST_HTTP_PORT=80
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_VITE_PORT=5173

# Laravel Debugbar (local profiling: queries, timeline, memory). Requires APP_DEBUG=true.
DEBUGBAR_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Auto migrate + seed on Docker php container start (local demo).
APP_AUTO_BOOTSTRAP=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For local Docker dev, switch to pgsql and never run tests against it.
# DB_CONNECTION=pgsql
# DB_HOST=database
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=secret

# Explicit opt-in for migrate:fresh / db:wipe on a real database.
DB_ALLOW_DESTRUCTIVE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Почта (переключение: только MAIL_MAILER) ---
# mailpit  — Docker dev (UI: http://localhost:8025)
# smtp     — внешний SMTP (mailbox.org, Yandex, Postfix relay на :25/:587)
# sendmail — локальный sendmail / ssmtp / Postfix (-bs)
# log      — без SMTP, письма в storage/logs/laravel.log

MAIL_MAILER=mailpit
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailpit (php-контейнер → host mailpit; artisan с хоста → 127.0.0.1 + smtp)
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Модуль настроек почты (до сохранения в админке)
MAIL_MODULE_MODE=preset
MAIL_MODULE_PRESET=mailpit
REQUIRE_EMAIL_VERIFICATION=false

# Dev-seeding (TD-10)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=password
SEED_OWNER_NAME=Owner

# Универсальный SMTP (MAIL_MAILER=smtp)
# MAIL_SCHEME=tls          # tls | smtps | null
# MAIL_HOST=smtp.mailbox.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Sendmail / ssmtp (MAIL_MAILER=sendmail)
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAIL_SENDMAIL_PATH="/usr/sbin/ssmtp"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Python AI service (profile: ai). See docs/CONFIGURATION.md
AI_SERVICE_URL=http://ai-service:8000
HOST_AI_SERVICE_PORT=8100
AI_SERVICE_DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@database:${DB_PORT}/${DB_DATABASE}
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Payments: mock (local), http (REST API in staging/prod)
PAYMENT_GATEWAY=mock
PAYMENT_HTTP_URL=
PAYMENT_HTTP_SECRET=
PAYMENT_HTTP_TIMEOUT=10
