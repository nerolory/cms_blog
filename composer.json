{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cms-blog/cms-blog",
    "type": "project",
    "description": "Production-oriented Laravel CMS blog: posts, moderation, API, Filament, optional AI worker.",
    "keywords": ["laravel", "cms", "blog", "filament"],
    "license": "LicenseRef-CBL-1.0",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-shield": "^4.2",
        "dedoc/scramble": "^0.13.27",
        "filament/filament": "^4.0",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "spatie/laravel-permission": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.3",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Tools\\PhpStan\\": "tools/phpstan/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint:php": "pint --test",
        "fix:php": "pint",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "check:phpdoc": "@php scripts/check-phpdoc.php",
        "check:phpdoc-quality": "@php scripts/check-phpdoc-quality.php",
        "check:line-length": "@php scripts/check-line-length.php",
        "fix:phpdoc": "@php scripts/fix-phpdoc.php",
        "audit": "composer audit",
        "check:quality": [
            "@lint:php",
            "@check:line-length",
            "@check:phpdoc",
            "@check:phpdoc-quality",
            "@analyse",
            "@audit"
        ],
        "check:php": [
            "@check:quality",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 900
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
