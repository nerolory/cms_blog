{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "cms-blog",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run copy:tinymce && vite build",
        "copy:tinymce": "node scripts/copy-tinymce.mjs",
        "postinstall": "node scripts/copy-tinymce.mjs",
        "dev": "vite",
        "lint:js": "eslint \"resources/js/**/*.{js,ts}\" \"tests/js/**/*.ts\" \"e2e/**/*.ts\"",
        "lint:css": "stylelint \"resources/css/**/*.css\"",
        "lint:html": "node scripts/validate-html.mjs",
        "test:unit": "vitest run --coverage",
        "typecheck:js": "tsc --noEmit",
        "format:blade": "blade-formatter --write \"resources/views/**/*.blade.php\"",
        "format:blade:check": "blade-formatter --check-formatted \"resources/views/**/*.blade.php\"",
        "format": "prettier --write \"resources/**/*.{js,css,json}\" && npm run format:blade",
        "audit": "npm audit --audit-level=moderate",
        "check:frontend": "npm run lint:js && npm run typecheck:js && npm run test:unit && npm run lint:css && npm run lint:html && npm run format:blade:check && npm run audit",
        "test:e2e": "playwright test --config=e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
        "fix:frontend": "prettier --write \"resources/**/*.{js,css,json}\" && npm run format:blade",
        "check:all": "npm run check:frontend && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@vitest/coverage-v8": "^4.1.0",
        "@playwright/test": "^1.55.0",
        "@popperjs/core": "^2.11.8",
        "@shufo/prettier-plugin-blade": "^1.15.0",
        "blade-formatter": "^1.44.0",
        "bootstrap": "^5.3.8",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "happy-dom": "^20.0.10",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.6.0",
        "stylelint": "^16.26.0",
        "stylelint-config-standard": "^39.0.0",
        "tinymce": "^7.9.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "prismjs": "^1.30.0",
        "tom-select": "^2.6.1"
    }
}
