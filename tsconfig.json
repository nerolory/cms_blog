{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["resources/js/**/*.ts", "tests/js/**/*.ts", "vitest.config.ts"]
}
